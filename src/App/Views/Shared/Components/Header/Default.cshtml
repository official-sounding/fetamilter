@model App.Models.HeaderModel;

<header>
        <div class="site-title">
            <h1>@Model.Site.Title</h1>
        </div>
        <div class="user-details">
            @if (Model.IsLoggedIn)
            {
                @Html.DisplayFor(m => m.Username) @Html.Raw(" |") <a href="/logout">Logout</a>
            }
            else
            {
                <a href="/login">Login</a>
            }
        </div>
</header>
    <nav>
        <ul>
            <li><a href="#">Fetamilter</a></li>
            <li><a href="#">AskFeta</a></li>
            <li><a href="#">FetaTalk</a></li>
        </ul>
    </nav>
