<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["SiteTitle"] - @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/App.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="@((ViewData["Site"] as SiteViewModel)!.ThemeCssPath)-light.css" asp-asp-append-version="true" />
</head>

<body>
    @(await Html.PartialAsync("Header.cshtml"))
    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - FetaMilter
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true" async defer></script>
</body>

</html>
