@model App.Models.PostpageModel;
@using App.Authorization;
@using Westwind.AspNetCore.Markdown
@{
    ViewData["Title"] = Model.Post.Title;
    bool userCanComment = (await AuthorizationService.AuthorizeAsync(User, Policy.MakeComment)).Succeeded;
}

<div class="content">
        @if(Model.Post.Tags?.Count > 0) {
    <aside id="tags">
        <h3>Tags</h3>
        <ul>
            @foreach(var tag in Model.Post.Tags) {
                <li>@tag.Name</li>
            }
        </ul>
    </aside>
    
    }
    <article>
        <h2>@Html.DisplayFor(m => m.Post.Title)</h2>
        <h3>@Html.DisplayFor(m => m.Post.PostedOn)</h3>
        <div class="postBody">
            @Html.Raw(Markdown.Parse(Model.Post.Body))
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Post.MoreInside))
        {
            <hr>
            <div class="moreInside">
                @Html.Raw(Markdown.Parse(Model.Post.MoreInside))
            </div>
        }
        <div class="logline">
            Posted by <a href="/user/@Model.Post.PostedByID">@Html.DisplayFor(m => m.Post.PostedByUsername)</a>
            (@Model.Post.Comments.Count comments total)
            @if ((await AuthorizationService.AuthorizeAsync(User, Policy.MakePost)).Succeeded) {
                <post-favorite-button post="@Model.Post.Number" full-text="true"></post-favorite-button>
            }
            
            @if (@Model.Post.Favorites.Count > 0) {
                <a href="/@Model.Post.Number/favorites">@Model.Post.Favorites.Count users marked this as a favorite</a>
            } 
        </div>
    </article>


    <div id="comments">
        @foreach (Data.Models.Comment comment in Model.Post.Comments)
        {
            <div class="comment" id="@comment.ID">
            @if(comment.Removed) {
                <div class="removed-tombstone">
                    Comment Removed
                </div>
            } else {
                @Html.Raw(Markdown.Parse(comment.Body))
                <div class="logline">
                    Posted by <a href="/user/@comment.PostedByID">@Html.DisplayFor(_ => comment.PostedBy.UserName)</a>
                    on @Html.DisplayFor(_ => comment.PostedOn)
                    @if (userCanComment) {
                        <comment-favorite-button post="@Model.Post.Number" comment="@comment.ID" initial="@comment.Favorites.Count" />
                    } else if(@comment.Favorites.Count > 0) {
                        <a href="/@Model.Post.Number/@comment.ID/favorites">@comment.Favorites.Count Favorites</a>
                    }
                </div>
            }
            </div>
        }

        @if (userCanComment)
        {
            <hr>
            <form method="post" action="@Model.Post.Number/comment">
                <div class="form-input">
                    <label for="body">Comment</label>
                    <textarea name="body" rows="15" cols="60"></textarea>
                </div>
                <button type="submit">Post Comment</button>
            </form> 
        } else {
            <p>Please <a href="/login?returnUrl=/@Model.Post.Number">Log In</a> to make a comment</p>
        }
    </div>

</div>