@using App.Authorization
@model App.Models.UserActivityPostModel;
@{
    ViewData["Title"] = $"User Activity";

    var countStart = Model.Posts.HasPreviousPage ? (Model.Posts.PageIndex-1) * Model.Posts.PageSize : 1;
    var countEnd = Model.Posts.HasNextPage ? (Model.Posts.PageIndex-1) * Model.Posts.PageSize : Model.Posts.TotalCount;
    var countSite = Model.Site?.Title ?? "All Subsites";

}

<div class="content">
    <h1>Activity from <a href="/user/@Model.User.ID">@Model.User.UserName</a></h1>
    <h3>Posts @(countStart) to @(countEnd) of @Model.Posts.TotalCount from @(countSite)</h3>
    <hr />
    @foreach (var item in Model.Posts)
    {
        <article>
            <div class="post">
                <h2><a href="/@item.Post.Number">@Html.DisplayFor(_ => item.Post.Title)</a></h2>
                <p>@Html.DisplayFor(_ => item.Post.Body)</p>
            </div>
            <div class="logline">
                Posted to @item.Post.Site.Title by <a href="/user/@item.Post.PostedByID">@Html.DisplayFor(_ => item.Post.PostedByUsername)</a>
                on @Html.DisplayFor(_ => item.Post.PostedOn)

                <a href="/@item.Post.Number">
                    @Html.DisplayFor(_ => item.CommentCount)
                    @(item.CommentCount == 1 ? "Comment" : "Comments")</a>
                @if ((await AuthorizationService.AuthorizeAsync(User, Policy.MakePost)).Succeeded) {
                    <post-favorite-button post="@item.Post.Number" />
                }
            </div>
        </article>
        <hr />
    }
</div>

<div>
    @if (Model.Posts.HasPreviousPage)
    {
        <a href="#">&lt; Prev Page</a>
    }

    @if (Model.Posts.HasNextPage)
    {
        <a href="#">Next Page &gt;</a>
    }
</div>